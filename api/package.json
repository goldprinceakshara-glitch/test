{
  "name": "gp-portal-api",
  "version": "2.0.0",
  "description": "GP Portal API — Express + PostgreSQL",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
