# ── GP Portal API — local development only ──
# On Railway you set these in the api service → Variables (nothing is read from a .env file there).

PORT=4000

# Local Postgres, e.g.  postgresql://postgres:postgres@localhost:5432/gp_portal
# On Railway:  ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gp_portal

# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_HEX_STRING
JWT_TTL=8h

# UI address(es) allowed to call the API. "*" = anyone. Comma-separate for several.
CORS_ORIGIN=http://localhost:3000

# Optional: password for the first-run admin + developer accounts (otherwise admin123 / developer123)
# SEED_ADMIN_PASSWORD=
